# Environment variables for AIdan (OPCIONAL)

# IA Analysis (Opcional - Sistema auto-detecta mejor opción)
# ANTHROPIC_API_KEY=tu_clave_claude_aqui  # Solo si quieres usar Claude (pago)

# Intervals (in seconds) - Opcional, usa valores por defecto
COLLECTOR_INTERVAL=600
ANALYZER_INTERVAL=120

# Data retention - Opcional
DATA_RETENTION_HOURS=72

# Logging - Opcional
LOG_LEVEL=INFO

# Nota: El sistema funciona sin necesidad de este archivo
# Modos de análisis (auto-detecta):
#   1. Ollama (local/gratis) - Recomendado si tienes 16GB RAM
#   2. Claude (API/pago) - Más preciso pero con costos
#   3. Keywords (fallback) - Siempre disponible
