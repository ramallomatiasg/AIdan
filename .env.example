# AIdan — variables de entorno (TODAS opcionales: sin este archivo el bot arranca igual)
# Copiar a `.env` y descomentar lo que se quiera cambiar.
# Los defaults reales viven en src/common/config.py — este archivo solo documenta.

# ── LLMs ─────────────────────────────────────────────────────────────────────
# Groq (free tier) — es el proveedor PRINCIPAL: noticias, pre-planner, chat.
# Config.GROQ_API_KEYS trae keys por defecto con rotacion; esto las pisa.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b          # analisis de noticias / pre-planner
#   (llama-3.3-70b-versatile y llama-3.1-8b-instant: DADOS DE BAJA 16-ago-2026)
# GROQ_REASONING_EFFORT=low               # gpt-oss razona: low = ~87 tokens
# GROQ_MODEL_CHAT=openai/gpt-oss-20b      # chat del dashboard (latencia <500ms)

# Ollama (local, opcional) — pre-filtro de noticias, auditoria de señal, post-trade.
# OLLAMA_URL=http://localhost:11434
# GEMMA_MODEL=qwen2.5:7b

# Claude (opcional, PAGO) — solo lo usa una rama alternativa de news_analyzer.
# ANTHROPIC_API_KEY=

# OJO: sin Groq NI Ollama el analisis de noticias devuelve None y loguea
# "AI NOT AVAILABLE". NO hay fallback por keywords — es intencional (v3.21) y
# esta fijado en un test.

# ── Broker (MetaTrader 5) ────────────────────────────────────────────────────
# Tambien se pueden cargar desde el panel del dashboard.
# MT5_ENABLED=true
# MT5_ACCOUNT=
# MT5_PASSWORD=
# MT5_SERVER=ICMarketsSC-Demo

# ── Telegram (opcional: alertas y comandos) ──────────────────────────────────
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Intervalos y retencion ───────────────────────────────────────────────────
# COLLECTOR_INTERVAL=60      # segundos entre fetch de noticias
# ANALYZER_INTERVAL=10       # segundos entre ciclos del analyzer
# DATA_RETENTION_HOURS=72
# LOG_LEVEL=INFO
# STATS_SINCE=2026-05-03 06:00:00   # corta las stats del dashboard desde una fecha

# ── Perillas de comportamiento ───────────────────────────────────────────────
# Existen para poder REVERTIR un cambio sin rebuildear el exe. El valor que
# figura es el default de hoy; el porque de cada uno esta en CLAUDE.md.

# POSITION_MANAGER_MODE=active     # log | active | off. El codigo default-ea a
#                                  # `log`, pero el sistema corre en `active`
#                                  # desde el 5-jun (experimento #1).
# COOLDOWN_AFTER_LOSS_MIN=5        # skip de señales <5min tras una perdida (0 = off)
# BE_TRIGGER_MAX_PIPS=5.0          # cap del umbral de break-even (0 = off) — solo h1
# BE_TRIGGER_MAX_TRACKS=h1_structure
# --- v3.61.0: fuentes del feed de noticias ---------------------------------
# NEWS_EXTRA_SOURCES=false         # true suma `extra_sources` de config/sources.yaml
#                                  # (FXStreet, Investing Economy, MarketWatch, Forexlive CB).
#                                  # APAGADA a proposito: ninguna reporta datos mas rapido que
#                                  # Forexlive y multiplican el volumen de un track que pierde
#                                  # $0,91/trade. Investing News llega a 149 items/hora.
# OJO: las fuentes ACTIVAS se editan en %APPDATA%/AIdan/config/sources.yaml (NO el del repo:
#      el exe solo copia config/ si la carpeta no existe). Toma efecto al proximo ciclo del
#      collector (60s), sin rebuild. Revertir a como estaba = dejar solo Bloomberg ahi.
# FEED_RACE_CYCLE_SEC=30           # solo para tools/measure_feed_race.py
# NEWS_PRE_EVENT_GUARD_MIN=15       # v3.62.0: una senal de NEWS no se ejecuta si hay un evento HIGH
#                                   # dentro de los proximos N min (clase #969: CALL 13 min antes del
#                                   # NFP con SL 4p, spike 34p, -$29,40). Post-dato sigue exento.
#                                   # 15 = la ventana previa del event-window. 0 = apagado.
# SIGNAL_MAX_AGE_MIN=10             # v3.61.1: una senal sin fill NO se ejecuta a mercado si tiene
#                                   # mas de N min (SL/TP calculados para un precio viejo, clase #625).
#                                   # pre_planned/calendar exentos. 0 = apagado (comportamiento previo).
# NEWS_MIN_EXPIRY_MIN=15           # GIRADA A 15 (=APAGADA) el 28-ago-2026: el veredicto
#                                  # pre-declarado de v3.51.0 NO paso -- los ganadores recorren
#                                  # 43,2% del TP (el gate pedia >=59%), los perdedores siguen
#                                  # en 53,1% del SL, y n=21 dio -$1,37/trade contra el baseline
#                                  # de -$0,91. El guard del codigo es `if _news_floor > 15`, asi
#                                  # que 15 no aplica override: news queda igual que en v3.50.4.
#                                  # Default del codigo = 45. Borrar la linea del .env revierte.
#                                  # OJO: Config se lee al importar => REINICIAR el exe (no rebuild).
# NEWS_PM_BASE_EXPIRY_MIN=15       # ancla del soft-expiry que ve el PM (0 = off)
# LEVEL_QUALITY_PENALTY=15         # castigo de confianza por nivel flojo (0 = off)
# LEVEL_QUALITY_TRACKS=M15
# M15_ATR_FLOOR=8.0                # piso de ATR de m15 (5.0 = como antes de v3.55.0).
#                                  # 8 saca el chop, donde m15 pierde consistente
#                                  # (<=8p: n=90 WR 27.8% -$75.59 | >8p: n=31 51.6% +$18.80).
#                                  # Cuesta el 74% de la frecuencia de m15.
# BREAKOUT_DIST_ATR_MULT=1.0       # tighten de entrada relativo a ATR (0 = off)
# LIMIT_ORDER_ENABLED=false        # el intento de orden limite nunca funciono (v3.53.4)
# ARCHIVE_REQUIRE_EXECUTION=true   # trade_archive solo acepta trades que llegaron al broker

# ── Experimentos en shadow (miden sin operar — NO activar sin evidencia) ─────
# LEARNING_ADJ_MODE=log            # log | active | off
# SETUP_WR_SOURCE_ARCHIVE=log      # log | on | off
# SKIP_BOUNCE_ENTRY=shadow         # off | shadow | active
# EVENT_WINDOW_MODE=shadow
# PULLBACK_ENTRY_MODE=shadow
# CALENDAR_MODE=shadow
# FADE_CHOP_MODE=off               # refutado 3 veces, apagado en v3.47.1
# D1_TRACK_MODE=shadow             # off | shadow | active — track D, swing DIARIO (v3.54.0).
#                                  # shadow = loguea a d1_shadow_log SIN operar (los otros
#                                  # 3 tracks intactos). NO poner active: el swap deja el
#                                  # CI cruzando cero y el lote minimo 0.01 no permite
#                                  # respetar el 1% con SL de ~82p. Ver CLAUDE.md.
# D1_SCAN_INTERVAL_SEC=900         # cada cuanto mira si hay vela D1 nueva
# ENTRY_GATES_ENABLED=false        # refutados en v3.38.1 (los 30 combos eran ruido)
# USE_ML_CONFIDENCE=false          # el AUC 0.75 era espejismo de corte unico (31-may)

# ── v3.57.0 — Retrospectiva PRE-decision + toggle del track news ─────────────
# RETRO_MODE=shadow                # off | shadow | active
#                                  # Antes de crear el trade, compara la senal con los
#                                  # trades similares (mismo setup, mismo bucket de vol) y
#                                  # penaliza la confianza si la direccion OPUESTA era la
#                                  # que pagaba. NUNCA bloquea, nunca invierte la direccion.
#                                  # shadow = calcula y registra en `pre_trade_retrospective`
#                                  # con delta 0 (default: no hay UNA medicion todavia de que
#                                  # el veredicto discrimine). active = aplica el delta.
# RETRO_MIN_N=6                    # n total minimo para emitir veredicto con delta != 0
# RETRO_MIN_PER_SIDE=3             # n por lado minimo para decir "la opuesta iba mejor"
# RETRO_FULL_N=15                  # a partir de este n el delta llega al maximo
# RETRO_MAX_DELTA=8                # tope del nudge en puntos de confianza (+/-)
# RETRO_LOOKBACK=40                # cuantos trades similares se miran hacia atras
#
# ENABLE_NEWS_TRACK=true           # false apaga la EJECUCION de news; el alert se sigue
#                                  # guardando y midiendo (measure_news_llm_error.py).
#                                  # Default true a proposito: decision del user 7-ago
#                                  # ("news no se apaga, se arregla") + veredicto
#                                  # pre-declarado ~28 ago. La perilla existe, girarla es
#                                  # decision del user.

# ── v3.60.0 — Shadow trader LLM (Groq): decide en PAPEL, jamas opera ─────────
# SHADOW_TRADER_MODE=shadow        # off | shadow. Un "operador" gpt-oss-120b ve los
#                                  # numeros del mercado + posiciones abiertas y decide
#                                  # (open: CALL/PUT/NONE; manage: CLOSE/HOLD). TODO va a
#                                  # `shadow_trader_log`; el modulo no tiene path de
#                                  # ejecucion (hay test). NO existe 'active' a proposito:
#                                  # el gate esta en tools/score_shadow_trader.py y a
#                                  # n>=40 sin separar se apaga.
# SHADOW_TRADER_CYCLE_SEC=300      # ciclo del manage (por posicion abierta)
# SHADOW_TRADER_SCAN_SEC=900       # throttle del open-scan (~96 llamadas Groq/dia)

# ── v3.63.0 — Calendar play (shadow): la ruta del precio en cada release HIGH ─────
# CALENDAR_PLAY_MODE=shadow        # off | shadow. Un thread muestrea bid/ask ~1s desde
#                                  # T-60s hasta T+15min en cada release HIGH USD/EUR del
#                                  # calendario y guarda ruta, excursiones, spread maximo y
#                                  # `actual` (FF o titulo Forexlive) en `calendar_play_log`.
#                                  # NO opera; no existe 'active'. Gate en
#                                  # tools/score_calendar_play.py (n>=25; a n>=40 sin pasar => off).

