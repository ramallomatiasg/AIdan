# AIdan — variables de entorno (TODAS opcionales: sin este archivo el bot arranca igual)
# Copiar a `.env` y descomentar lo que se quiera cambiar.
# Los defaults reales viven en src/common/config.py — este archivo solo documenta.

# ── LLMs ─────────────────────────────────────────────────────────────────────
# Groq (free tier) — es el proveedor PRINCIPAL: noticias, pre-planner, chat.
# Config.GROQ_API_KEYS trae keys por defecto con rotacion; esto las pisa.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile      # analisis de noticias / pre-planner
# GROQ_MODEL_CHAT=llama-3.1-8b-instant    # chat del dashboard (latencia <500ms)

# Ollama (local, opcional) — pre-filtro de noticias, auditoria de señal, post-trade.
# OLLAMA_URL=http://localhost:11434
# GEMMA_MODEL=qwen2.5:7b

# Claude (opcional, PAGO) — solo lo usa una rama alternativa de news_analyzer.
# ANTHROPIC_API_KEY=

# OJO: sin Groq NI Ollama el analisis de noticias devuelve None y loguea
# "AI NOT AVAILABLE". NO hay fallback por keywords — es intencional (v3.21) y
# esta fijado en un test.

# ── Broker (MetaTrader 5) ────────────────────────────────────────────────────
# Tambien se pueden cargar desde el panel del dashboard.
# MT5_ENABLED=true
# MT5_ACCOUNT=
# MT5_PASSWORD=
# MT5_SERVER=ICMarketsSC-Demo

# ── Telegram (opcional: alertas y comandos) ──────────────────────────────────
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Intervalos y retencion ───────────────────────────────────────────────────
# COLLECTOR_INTERVAL=60      # segundos entre fetch de noticias
# ANALYZER_INTERVAL=10       # segundos entre ciclos del analyzer
# DATA_RETENTION_HOURS=72
# LOG_LEVEL=INFO
# STATS_SINCE=2026-05-03 06:00:00   # corta las stats del dashboard desde una fecha

# ── Perillas de comportamiento ───────────────────────────────────────────────
# Existen para poder REVERTIR un cambio sin rebuildear el exe. El valor que
# figura es el default de hoy; el porque de cada uno esta en CLAUDE.md.

# POSITION_MANAGER_MODE=active     # log | active | off. El codigo default-ea a
#                                  # `log`, pero el sistema corre en `active`
#                                  # desde el 5-jun (experimento #1).
# COOLDOWN_AFTER_LOSS_MIN=5        # skip de señales <5min tras una perdida (0 = off)
# BE_TRIGGER_MAX_PIPS=5.0          # cap del umbral de break-even (0 = off) — solo h1
# BE_TRIGGER_MAX_TRACKS=h1_structure
# NEWS_MIN_EXPIRY_MIN=45           # 0/15 = comportamiento previo a v3.51.0
# NEWS_PM_BASE_EXPIRY_MIN=15       # ancla del soft-expiry que ve el PM (0 = off)
# LEVEL_QUALITY_PENALTY=15         # castigo de confianza por nivel flojo (0 = off)
# LEVEL_QUALITY_TRACKS=M15
# BREAKOUT_DIST_ATR_MULT=1.0       # tighten de entrada relativo a ATR (0 = off)
# LIMIT_ORDER_ENABLED=false        # el intento de orden limite nunca funciono (v3.53.4)
# ARCHIVE_REQUIRE_EXECUTION=true   # trade_archive solo acepta trades que llegaron al broker

# ── Experimentos en shadow (miden sin operar — NO activar sin evidencia) ─────
# LEARNING_ADJ_MODE=log            # log | active | off
# SETUP_WR_SOURCE_ARCHIVE=log      # log | on | off
# SKIP_BOUNCE_ENTRY=shadow         # off | shadow | active
# EVENT_WINDOW_MODE=shadow
# PULLBACK_ENTRY_MODE=shadow
# CALENDAR_MODE=shadow
# FADE_CHOP_MODE=off               # refutado 3 veces, apagado en v3.47.1
# D1_TRACK_MODE=shadow             # off | shadow | active — track D, swing DIARIO (v3.54.0).
#                                  # shadow = loguea a d1_shadow_log SIN operar (los otros
#                                  # 3 tracks intactos). NO poner active: el swap deja el
#                                  # CI cruzando cero y el lote minimo 0.01 no permite
#                                  # respetar el 1% con SL de ~82p. Ver CLAUDE.md.
# D1_SCAN_INTERVAL_SEC=900         # cada cuanto mira si hay vela D1 nueva
# ENTRY_GATES_ENABLED=false        # refutados en v3.38.1 (los 30 combos eran ruido)
# USE_ML_CONFIDENCE=false          # el AUC 0.75 era espejismo de corte unico (31-may)

# ── Reportes (opcional) ──────────────────────────────────────────────────────
# GOOGLE_SHEETS_CREDS=config/google_creds.json
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_NAME=AIdan - Trading Report
